MERGE (n:Track:Entity {id: "gear_moog_sub37"}) ON CREATE SET n.name = "Moog Sub 37 Paraphonic Synthesizer", n.country = "None", n.description = "Paraphonic analog synthesizer featuring two variable-waveshape oscillators, a classic Moog ladder filter with multi-drive saturation, and dual DAHDSR loopable envelopes. The definitive bass engine for melodic techno.", n.classified_subgenre = "", n.detected_bpm = 0.0;
MERGE (n:Track:Entity {id: "gear_space_echo_re201"}) ON CREATE SET n.name = "Roland Space Echo RE-201", n.country = "None", n.description = "Legendary 1974 analog magnetic tape delay and spring reverb unit. Generates warm harmonic saturation, subtle tape wow/flutter, and self-oscillating resonant dub feedback loops essential for ambient and dub acoustics.", n.classified_subgenre = "", n.detected_bpm = 0.0;
MERGE (n:Track:Entity {id: "gear_tb303"}) ON CREATE SET n.name = "Roland TB-303 Bass Line", n.country = "None", n.description = "Iconic 1981 analog bass synthesizer with diode ladder filter and accent circuitry. Accidental misuse of its cutoff and resonance knobs birthed acid house in Chicago and revolutionized global rave culture.", n.classified_subgenre = "", n.detected_bpm = 0.0;
MERGE (n:Track:Entity {id: "gear_tr808"}) ON CREATE SET n.name = "Roland TR-808 Rhythm Composer", n.country = "None", n.description = "Transistorized analog rhythm machine introduced by Roland in 1980. Its booming sine-wave decay kick and crisp hand-clap became the sonic foundation for hip-hop, trap, Miami bass, and modern pop.", n.classified_subgenre = "", n.detected_bpm = 0.0;
