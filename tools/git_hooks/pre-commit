#!/usr/bin/env bash

# Fail fast
set -euo pipefail

echo "== Pre-commit: running lint, format and smoke tests =="

# Resolve project root
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# Ensure env vars and PYTHONPATH are correct
source "${PROJECT_ROOT}/tools/shell_scripts/export_vars.sh"

# Run checks
make smoke_test

echo "== Pre-commit checks passed =="
