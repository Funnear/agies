{
  "makefile.configureOnOpen": false,

  // --- Python environment ---
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",

  // Don't let VS Code auto-format; we use Black via make/CI
  "editor.formatOnSave": false,
  "[python]": {
    "editor.formatOnSave": false
  },

  // --- Testing: pytest in tests/ ---
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,

  // --- Import resolution for damn_ape (mirrors PYTHONPATH=src) ---
  "python.analysis.extraPaths": ["src", "libs/data_ravers_utils"],

  // --- Jupyter ---
  "jupyter.notebookFileRoot": "${workspaceFolder}",

  // --- Spellchecker quality-of-life ---
  "cSpell.words": [
    "Agentic",
    "Biohacker",
    "BPNT",
    "brandshop",
    "damn_ape",
    "Effectance",
    "embedder",
    "Faen",
    "FAISS",
    "Faniia",
    "githook",
    "huggingface",
    "ipykernel",
    "Kaggle",
    "lifehacks",
    "Liskov",
    "mindmap",
    "Mindmaps",
    "misattunement",
    "mmdc",
    "neurodivergence",
    "ORCID",
    "PCRE",
    "Prazdnikova",
    "Pydantic",
    "pytest",
    "PYTHONPATH",
    "Qwen",
    "Referer",
    "Streamlit",
    "TinyLlama",
    "TOON",
    "toplevel",
    "venv",
    "Zenodo"
  ],

  // --- Mermaid .mmd files ---
  "files.associations": {
    "*.mmd": "mermaid"
  },
  "mermaid.enableExperimental": true,
  "mermaid-preview.theme": "default",
  "mermaid-preview.scale": 1.0,
  "chat.agent.codeBlockProgress": false,
  "chat.agent.enabled": false,
  "chat.agent.thinking.generateTitles": false,
  "chat.agent.thinking.collapsedTools": "off",
  "chat.checkpoints.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.detectParticipant.enabled": false,
  "chat.exitAfterDelegation": false,
  "chat.extensionTools.enabled": false,
  "chat.extensionUnification.enabled": false,
  "accessibility.verbosity.terminalChatOutput": false,
  "accessibility.verbosity.panelChat": false,
  "accessibility.verbosity.inlineChat": false,
  "accessibility.verboseChatProgressUpdates": false,
  "chat.implicitContext.suggestedContext": false,
  "chat.math.enabled": false,
  "chat.notifyWindowOnResponseReceived": "off",
  "chat.notifyWindowOnConfirmation": "off",
  "chat.sendElementsToChat.attachCSS": false,
  "chat.sendElementsToChat.enabled": false,
  "chat.showAgentSessionsViewDescription": false,
  "chat.suspendThrottling": false,
  "chat.todoListTool.descriptionField": false,
  "chat.tools.terminal.enableAutoApprove": false,
  "chat.tools.todos.showWidget": false,
  "chat.undoRequests.restoreInput": false,
  "chat.useAgentsMdFile": false,
  "chat.viewSessions.enabled": false,
  "chat.viewTitle.enabled": false,
  "chat.viewWelcome.enabled": false,
  "inlineChat.holdToSpeech": false,
  "github.copilot.chat.agent.currentEditorContext.enabled": false,
  "github.copilot.chat.codeGeneration.useInstructionFiles": false,
  "github.copilot.chat.copilotDebugCommand.enabled": false,
  "github.copilot.chat.customInstructionsInSystemMessage": false,
  "github.copilot.chat.edits.suggestRelatedFilesForTests": false,
  "github.copilot.chat.edits.suggestRelatedFilesFromGitHistory": false,
  "github.copilot.chat.imageUpload.enabled": false,
  "github.copilot.chat.languageContext.typescript.enabled": false,
  "github.copilot.chat.newWorkspaceCreation.enabled": false,
  "github.copilot.chat.setupTests.enabled": false,
  "github.copilot.chat.summarizeAgentConversationHistory.enabled": false,
  "github.copilot.chat.reviewSelection.enabled": false,
  "github.copilot.chat.reviewAgent.enabled": false,
  "github.copilot.chat.useResponsesApi": false,
  "github.copilot.chat.useProjectTemplates": false,
  "githubPullRequests.experimental.chat": false,
  "notebook.experimental.generate": false,
  "workbench.browser.sendElementsToChat.attachImages": false
}